---
import Base from '../layouts/Base.astro';
import TagWall from '../components/TagWall.astro';
import EntryRow from '../components/EntryRow.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAllEntries, getAllTags, formatDate, getStats } from '../lib/content';
import { tagTone } from '../lib/tags';
import { href } from '../lib/url';

const [tags, stats, entries] = await Promise.all([
  getAllTags(),
  getStats(),
  getAllEntries(),
]);

const latest = entries.slice(0, 5);
const updated = entries[0]?.data.updated;
const topTags = tags.slice(0, 8);
---

<Base>
  <section class="hero">
    <div class="hero__copy">
      <p class="mono-label">PERSONAL ARCHIVE / 2026</p>
      <h1 class="display">
        <span class="display__line">提示词</span>
        <span class="display__line display__line--accent">与技能</span>
      </h1>
      <p class="hero__lead">
        把真正好用的提示词与 agent 技能收进来：原文可复制，用法可追溯，标签自动汇总。
      </p>
      <div class="hero__foot">
        <p class="hero__note">
          {String(stats.prompts).padStart(2, '0')} 条提示词 ·
          {String(stats.skills).padStart(2, '0')} 个技能<br />
          {String(stats.tags).padStart(2, '0')} 个标签 · 更新于
          {updated ? formatDate(updated) : '—'}
        </p>
        <a class="btn btn--primary" href={href('/prompts/')}>浏览提示词 →</a>
      </div>
    </div>
    <TagWall tags={topTags} />
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="section-head__index">01</p>
        <h2 class="section-head__title">最新收录</h2>
        <p class="section-head__lede">提示词与技能按更新时间排在一起；每条都保留原文、用法与已知限制。</p>
      </div>
      {latest.length > 0 ? (
        <div class="chapter-index">
          {latest.map((entry, index) => (
            <EntryRow entry={entry} index={index} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="还没有收录"
          body="在 src/content/prompts/ 或 src/content/skills/ 下新建 Markdown 文件，或运行 pnpm new:prompt / new:skill。"
        />
      )}
      <div class="btn-row">
        <a class="btn" href={href('/prompts/')}>全部提示词 →</a>
        <a class="btn" href={href('/skills/')}>全部技能 →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="section-head__index">02</p>
        <h2 class="section-head__title">标签索引</h2>
        <p class="section-head__lede">标签从条目里自动汇总；同一个标签可以跨提示词与技能。</p>
      </div>
      {tags.length > 0 ? (
        <div class="chapter-index">
          {tags.map((tag, index) => (
            <a
              class={`chapter-row chapter-row--${tagTone(tag.slug)}`}
              href={href(`/tags/${tag.slug}/`)}
            >
              <span class="chapter-row__num">{String(index + 1).padStart(2, '0')}</span>
              <span class="chapter-row__title">#{tag.name}</span>
              <span class="chapter-row__lede">
                标签下的全部条目
                <span class="chapter-row__meta">{tag.count} 条</span>
              </span>
              <span class="chapter-row__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      ) : (
        <EmptyState
          title="还没有标签"
          body="给条目加上 tags 后，标签会自动出现在这里；不需要修改代码。"
        />
      )}
    </div>
  </section>
</Base>
