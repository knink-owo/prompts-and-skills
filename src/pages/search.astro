---
import Base from '../layouts/Base.astro';
import ChapterHero from '../components/ChapterHero.astro';
import EntryRow from '../components/EntryRow.astro';
import EmptyState from '../components/EmptyState.astro';
import FilterBar from '../components/FilterBar.astro';
import { getAllEntries, searchText } from '../lib/content';

const entries = await getAllEntries();
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const needle = q.toLowerCase();
const matches = needle
  ? entries.filter((entry) => searchText(entry).includes(needle))
  : entries;
const visible = new Set(matches.map((entry) => `${entry.collection}:${entry.id}`));
---

<Base
  title="搜索"
  description="跨提示词与技能搜索标题、摘要、标签与模型；查询在浏览器本地完成。"
>
  <ChapterHero
    index="SEARCH / LOCAL"
    title="搜索"
    lede="跨提示词与技能搜索标题、摘要、标签与模型。查询在浏览器本地完成，不发送到服务器。"
    meta={q ? `查询：${q}` : '全部条目'}
    tone="sky"
  />

  <section class="section" data-filter data-filter-url>
    <div class="wrap">
      <div class="section-head">
        <p class="section-head__index">01</p>
        <h2 class="section-head__title">结果</h2>
        <p class="section-head__lede">输入即筛选；也可以用浏览器刷新保留查询参数。</p>
      </div>

      <FilterBar
        count={matches.length}
        showCategories={false}
        q={q}
        action="/search/"
      />

      <noscript>
        <p class="note">
          没有 JavaScript 时，本页展示全部条目；请用浏览器查找（Ctrl/⌘ + F）定位关键词。
        </p>
      </noscript>

      <div class="chapter-index">
        {entries.map((entry, index) => (
          <EntryRow
            entry={entry}
            index={index}
            hidden={needle !== '' && !visible.has(`${entry.collection}:${entry.id}`)}
          />
        ))}
      </div>

      <EmptyState
        hidden={matches.length > 0}
        title="没有匹配的条目"
        body="换一个关键词，或去目录按分类浏览。"
      />
    </div>
  </section>
</Base>
