---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ChapterHero from '../../components/ChapterHero.astro';
import EntryRow from '../../components/EntryRow.astro';
import EmptyState from '../../components/EmptyState.astro';
import FilterBar from '../../components/FilterBar.astro';
import { CATEGORIES } from '../../site.config';
import { getEntriesByCategory } from '../../lib/content';
import { href } from '../../lib/url';

export const getStaticPaths = (async () =>
  CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

interface Props {
  category: (typeof CATEGORIES)[number];
}

const { category } = Astro.props;
const entries = await getEntriesByCategory(category.name);
---

<Base
  title={`${category.name} · 分类`}
  description={`${category.name}分类下的全部提示词与技能。${category.description}`}
>
  <ChapterHero
    index={`CATEGORY / ${category.slug.toUpperCase()}`}
    title={category.name}
    lede={category.description}
    meta={`${entries.length} 条 · 分类索引`}
    tone={category.tone}
  />

  <section class="section" data-filter>
    <div class="wrap">
      <div class="section-head">
        <p class="section-head__index">01</p>
        <h2 class="section-head__title">{category.name}条目</h2>
        <p class="section-head__lede">按更新时间排序；可在本分类内继续搜索。</p>
      </div>

      <FilterBar count={entries.length} showCategories={false} />

      {entries.length > 0 ? (
        <div class="chapter-index">
          {entries.map((entry, index) => (
            <EntryRow entry={entry} index={index} />
          ))}
        </div>
      ) : (
        <EmptyState
          title={`「${category.name}」还没有条目`}
          body="换一个分类，或去目录看全部入口。"
        />
      )}

      <EmptyState
        hidden
        title="没有匹配的条目"
        body="换一个关键词，或清除搜索。"
      />

      <div class="btn-row">
        <a class="btn" href={href('/catalog/')}>← 返回目录</a>
      </div>
    </div>
  </section>
</Base>
