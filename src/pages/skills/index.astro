---
import Base from '../../layouts/Base.astro';
import ChapterHero from '../../components/ChapterHero.astro';
import EntryRow from '../../components/EntryRow.astro';
import EmptyState from '../../components/EmptyState.astro';
import FilterBar from '../../components/FilterBar.astro';
import { formatDate, getAllTags, getSkills } from '../../lib/content';

const [skills, tags] = await Promise.all([getSkills(), getAllTags()]);
const latest = skills[0]?.data.updated;
const meta = [
  `${String(skills.length).padStart(2, '0')} 个`,
  latest ? `最近更新 ${formatDate(latest)}` : '等待第一条',
].join(' · ');
---

<Base
  title="技能"
  description="可复用的 agent 技能：安装方式、适用环境、文件清单与版本；与提示词共用标签。"
>
  <ChapterHero
    index="COLLECTION / SKILLS"
    title="技能"
    lede="可复用的 agent 技能：安装方式、适用环境与文件清单。"
    meta={meta}
    tone="moss"
  />

  <section class="section" data-filter>
    <div class="wrap">
      <div class="section-head">
        <p class="section-head__index">01</p>
        <h2 class="section-head__title">全部技能</h2>
        <p class="section-head__lede">按更新时间排序。技能与提示词共用标签，筛选在本地完成。</p>
      </div>

      <FilterBar count={skills.length} tags={tags} />

      {skills.length > 0 ? (
        <div class="chapter-index">
          {skills.map((entry, index) => (
            <EntryRow entry={entry} index={index} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="技能库还是空的"
          body="技能和提示词共用一套 frontmatter；新增一条后，这里会自动出现。"
          filter={false}
        >
          <p class="mono-label">pnpm new:skill</p>
        </EmptyState>
      )}

      <EmptyState
        hidden
        title="没有匹配的技能"
        body="换一个关键词，或清除标签筛选。"
      />
    </div>
  </section>
</Base>
