---
import type { TagSummary } from '../lib/tags';
import { tagName, tagTone } from '../lib/tags';
import { href } from '../lib/url';

interface Props {
  tags: TagSummary[];
}

const { tags } = Astro.props;
---

<aside class="hero__wall" aria-label="标签索引">
  {tags.map((tag) => (
    <a
      class={`wall-band tone-${tagTone(tag.slug)}`}
      href={href(`/tags/${tag.slug}/`)}
      title={`${tag.count} 条`}
    >
      <span class="wall-band__name">#{tagName(tag.name)}</span>
      <span class="wall-band__count">{String(tag.count).padStart(2, '0')}</span>
    </a>
  ))}
</aside>
