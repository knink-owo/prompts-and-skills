---
import type { TagSummary } from '../lib/tags';
import { href } from '../lib/url';

interface Props {
  count: number;
  tags?: TagSummary[];
  q?: string;
  action?: string;
}

const {
  count,
  tags = [],
  q = '',
  action = '/search/',
} = Astro.props;
---

<form
  class="filter-bar"
  action={href(action)}
  method="get"
  role="search"
  data-filter-bar
>
  <label class="form-field__label" for="filter-q">搜索</label>
  <input
    class="input"
    id="filter-q"
    name="q"
    type="search"
    value={q}
    placeholder="标题、标签、模型…"
    autocomplete="off"
    data-filter-input
  />
  {tags.length > 0 && (
    <div class="tag-row" role="group" aria-label="按标签筛选">
      {tags.map((tag) => (
        <button
          type="button"
          class="chip"
          data-filter-tag={tag.slug}
          aria-pressed="false"
        >
          {tag.name}
        </button>
      ))}
    </div>
  )}
  <button type="submit" class="btn btn--quiet">搜索</button>
  <span class="mono-label filter-bar__count" data-filter-count aria-live="polite">
    {count} 条
  </span>
</form>
